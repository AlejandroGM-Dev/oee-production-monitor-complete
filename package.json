{
  "name": "oee-production-monitor",
  "version": "1.0.0",
  "private": true,
  "description": "Full stack OEE production line monitor built with Node.js, Express, React and SQLite.",
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "start:backend": "npm start --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "test:backend": "npm test --prefix backend",
    "db:init": "npm run db:init --prefix backend",
    "db:reset": "npm run db:reset --prefix backend",
    "db:summary": "npm run db:summary --prefix backend"
  }
}